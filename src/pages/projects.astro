---
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";

const page = await getEntry("pages", "projects");

if (!page) {
  throw new Error('Missing content entry: "pages/projects".');
}

const { Content } = await page.render();

// Keep the projects in the intended portfolio order without inventing dates.
const projectOrder = [
  "windows-server-active-directory-lab",
  "home-network-opnsense-and-adguard-home",
  "building-my-home-pc",
];

const projects = (await getCollection("projects")).sort((a, b) => {
  const aPosition = projectOrder.indexOf(a.slug);
  const bPosition = projectOrder.indexOf(b.slug);

  return aPosition - bPosition;
});
---

<Layout title={page.data.title} description={page.data.description}>
  <h1>{page.data.title}</h1>
  <Content />

  <section aria-label="Project posts">
    <h2>Project Details</h2>

    {
      projects.length > 0 ? (
        <ul class="projects-list">
          {projects.map((project) => (
            <li>
              <h3>
                <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
              </h3>
              <p class="projects-list-category">{project.data.category}</p>
              <p>{project.data.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p>No project posts yet.</p>
      )
    }
  </section>
</Layout>

<style>
  .projects-list {
    list-style: none;
    padding: 0;
    margin-block-start: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    margin-block-end: 1rem;
  }

  .projects-list li {
    border: 1px solid rgb(var(--white));
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .projects-list p {
    margin-bottom: 0;
  }

  .projects-list-category {
    margin-block-start: 0.5rem !important;
    margin-block-end: 1rem !important;
    font-size: 0.875rem;
  }
</style>
