---
import { Icon } from "astro-icon/components";
---

<aside class="sidebar-inner">
  <nav>
    <ul>
      <li>
        <a href="/about">
          <!-- icon -->
          <Icon name="tabler:user" class="icon" />
          About</a
        >
      </li>
      <!-- projects -->
      <li>
        <a href="/projects">
          <!-- icon -->
          <Icon name="tabler:briefcase" class="icon" />
          Projects</a
        >
      </li>
      <!-- blog -->
      <li>
        <a href="/blog">
          <!-- icon -->
          <Icon name="tabler:book" class="icon" />
          Blog</a
        >
      </li>
      <!-- contact -->
      <li>
        <a href="/contact">
          <!-- icon -->
          <Icon name="tabler:mail" class="icon" />
          Contact</a
        >
      </li>
    </ul>
  </nav>
</aside>

<style>
  aside {
    border: 1px solid var(--grey);
    border-radius: 1rem;
    padding: 1.5rem;
    min-width: 150px;
    background-color: var(--dark);
  }

  ul {
    padding-inline-start: 0;
    margin-block-start: 0;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  li a {
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  li a .icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--brand); /* controls stroke/fill for Tabler */
  }

  @media (max-width: 767px) {
    .sidebar-inner {
      align-items: center;
      text-align: center;
    }

    aside {
      padding: 0rem 1rem;
    }

    nav ul {
      gap: 0.5rem;
      flex-direction: row;
      margin-block: 0.5rem;
      justify-content: space-between;
    }

    li a {
      flex-direction: column;
      font-size: 1rem;
      gap: 0;
    }
  }
</style>
