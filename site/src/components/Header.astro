</header>

<style>
  header {
    padding-block: 1rem;
  }
  .header-left svg {
    height: 80px;
  }

  .small {
    font-size: 0.875rem;
  }

  .header-right {
    text-align: right;
  }

  .header-middle {
    margin-inline-start: auto;
  }

  #cloud path {
    fill: rgb(var(--white)) !important;
  }

  #edge path {
    fill: var(--brand) !important;
  }

  .header--inner {
    display: flex;
    justify-content: space-between;
    border: 1px solid var(--grey);
    border-radius: 1rem;
    padding: 1.5rem;
    background-color: var(--dark);
    gap: 1.5rem;
  }

  .header-location,
  .header-title {
    margin-block-start: 0;
  }

  .header-subtitle {
    margin-block-end: 1em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  header .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (max-width: 767px) {
    .header--inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .header-right {
      text-align: center;
    }

    .header-left svg {
      height: 60px;
    }
  }

  @media (max-width: 575px) {
    .header-left svg {
      height: auto;
      width: 100%;
    }
  }
</style>
