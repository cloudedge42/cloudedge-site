    <!-- middle -->
    <!-- <div class="header-middle"></div> -->
    <!-- <a href="mailto:sam@cloudedge.dev" class="small">sam@cloudedge.dev</a>
   
    <p class="header-location small">Liverpool, UK</p> -->
    <!-- right -->
    <div class="header-right">
      <h3 class="header-title">Sam Gardiner</h3>
      <p class="header-subtitle">
        <Icon name="tabler:brand-aws" class="icon" />
        Cloud Support Associate
        <!-- aws icon -->
      </p>
      <div class="icons">
        <Icon name="tabler:brand-github" class="icon" />
        <Icon name="tabler:brand-linkedin" class="icon" />
      </div>
    </div>
